# Admin panel and base for HTTP tunnels: https://<name>.bnat.example.com
BNAT_DOMAIN=bnat.example.com
# Host printed for ssh/tcp tunnels (defaults to BNAT_DOMAIN)
BNAT_TCP_HOST=tun.bnat.example.com
# Let's Encrypt contact
BNAT_ACME_EMAIL=you@example.com
# Leave empty to generate one on first start (printed to the logs once)
BNAT_ADMIN_PASSWORD=
# Release mirror for clients that can't reach GitHub (needs a DNS record;
# *.bnat.example.com already covers it):
#   curl -fsSL https://release.bnat.example.com/install.sh | sh
BNAT_RELEASES_HOST=release.bnat.example.com
# Ports handed out to ssh/tcp tunnels
BNAT_PORTS=20000-29999

# --- Behind an existing reverse proxy (Caddy, nginx, Traefik) that terminates TLS ---
# Proxy bnat.example.com and *.bnat.example.com to 127.0.0.1:8080 with WebSocket support.
# BNAT_TLS=false
# BNAT_HTTP=127.0.0.1:8080
# BNAT_PUBLIC_SCHEME=https
