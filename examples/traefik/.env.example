# Admin panel and base for HTTP tunnels: https://<name>.bnat.example.com
BNAT_DOMAIN=bnat.example.com
# Host printed for ssh/tcp tunnels (defaults to BNAT_DOMAIN)
BNAT_TCP_HOST=tun.bnat.example.com
# Release mirror for clients that can't reach GitHub:
#   curl -fsSL https://release.bnat.example.com/install.sh | sh
BNAT_RELEASES_HOST=release.bnat.example.com
# Leave empty to generate one on first start (docker compose logs bnat | grep password)
BNAT_ADMIN_PASSWORD=

# Let's Encrypt contact
ACME_EMAIL=you@example.com
# Cloudflare API token with Zone → DNS → Edit permission for the zone of BNAT_DOMAIN.
# Using another DNS provider? Change dnschallenge.provider in docker-compose.yml
# and set that provider's variables instead.
CF_DNS_API_TOKEN=
